PORT=8080
# Set to the project ID of your Firebase project
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to Firebase Admin service account JSON on the server (never put this file in the Android app or ZIP)
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-admin-service-account.json
# Use a long random value in production
APP_SECRET=replace-with-a-long-random-secret
